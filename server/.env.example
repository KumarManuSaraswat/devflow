NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/devflow?sslmode=require"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

CLIENT_URL="http://localhost:5173"
COOKIE_SECURE=false

# Built-in advisor works with no keys and no AI charges. Cloud is OFF by default.
# Enable only after verifying BOTH configured provider accounts are free-tier,
# without billing/paid upgrades, and that your users meet each provider's terms.
ASSISTANT_CLOUD_ENABLED=false
ASSISTANT_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
GROQ_API_KEY=
# Shared daily request caps (UTC), not provider token quotas. 0 disables a provider.
ASSISTANT_GEMINI_DAILY_REQUESTS=40
ASSISTANT_GROQ_DAILY_REQUESTS=80
# Mobile inbox (enable only after deploying the Android-notifications migration).
NOTIFICATIONS_ENABLED=false
PUSH_ENABLED=false
# Server secret only: choose an environment JSON value OR a secret-file path.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
